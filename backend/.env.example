# TA Backend - SPP Payment System
# Copy file ini ke .env lalu sesuaikan: cp .env.example .env

# DATABASE_URL (SQLite untuk development, PostgreSQL untuk production)
# SQLite (default untuk Docker development)
DATABASE_URL=sqlite:///./ta_spp.db
# PostgreSQL (uncomment untuk production / PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/ta_spp
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# JWT
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# File upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Supabase (optional)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
