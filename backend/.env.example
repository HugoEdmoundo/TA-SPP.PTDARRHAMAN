# TA Backend - SPP Payment System

# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DATABASE_URL=postgresql://user:password@localhost:5432/ta_spp

SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Supabase (optional, for client-side usage reference)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
